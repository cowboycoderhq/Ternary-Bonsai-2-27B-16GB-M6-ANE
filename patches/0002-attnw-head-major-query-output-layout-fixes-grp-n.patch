From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Cowboy Coder <howdy@cowboycoderhq.com>
Date: Tue, 13 Oct 2026 02:42:05 +0000
Subject: [PATCH] AttnW: head-major query/output layout (fixes grp == nkv on
 the M6 ANE)

With grp == nkv (Ornith-1.5-9B: 16 query / 4 KV heads), the old
reshape(T, nkv, grp, hd).permute(1, 2, 0, 3) view has two equal-size axes and
the M6 ANE lowering swapped them (per-head error 20-65% for 12 of 16 heads).
The head-major form is identical math; for the 27B (grp 6) nothing changes.
tests/test_attn_head_layout.py checks AttnW against the torch reference.
---
 coreai/qwen38_coreai_build.py | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/coreai/qwen38_coreai_build.py b/coreai/qwen38_coreai_build.py
index e10459fab16fd253e79d9fc6e339dddcfba16f97..6c3a608d6c33f18b79fd6c4b170cd54e0aeee6ee 100644
--- a/coreai/qwen38_coreai_build.py
+++ b/coreai/qwen38_coreai_build.py
@@ -557,7 +557,9 @@ class AttnW(nn.Module):
             return torch.cat([r * c3 + torch.cat([-r[..., rot // 2:], r[..., :rot // 2]], -1) * s3, rest], -1)
         qh = rope(qh)
         kt, vt = rope(kh).permute(1, 0, 2), vh.permute(1, 0, 2)                              # (nkv, T, hd)
-        qg4 = qh.reshape(T, nkv, grp, hd).permute(1, 2, 0, 3).reshape(nkv, grp * T, hd)
+        # rows (g, t) per KV head. Head-major first, then a contiguous split: with grp == nkv (Ornith 9B: 4 / 4) the
+        # one-step reshape(T, nkv, grp, hd).permute(1, 2, 0, 3) has two equal axes and the ANE lowering swapped them
+        qg4 = qh.permute(1, 0, 2).reshape(nkv, grp * T, hd)
         causal = (1 - tri(T, False)) * -1e4
         sc_b = ((qg4 @ kt.transpose(1, 2)) * hd ** -0.5).reshape(nkv, grp * T, T) + causal.repeat(grp, 1)  # rows (g, t)
         forms = _FORMS_OVERRIDE if _FORMS_OVERRIDE is not None else \
@@ -750,7 +752,7 @@ class AttnW(nn.Module):
                     else:
                         num = num + e_ @ vtile(a, b)
             o = num / den
-        o = o.reshape(nkv, grp, T, hd).permute(2, 0, 1, 3).reshape(T, nh * hd) * torch.sigmoid(gate)
+        o = o.reshape(nh, T, hd).permute(1, 0, 2).reshape(T, nh * hd) * torch.sigmoid(gate)
         o = o.transpose(0, 1).reshape(1, nh * hd, 1, T)
         if DBG_O:
             _DBG.append(o)
