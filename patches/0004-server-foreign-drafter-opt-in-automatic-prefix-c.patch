+
+    @staticmethod
+    def _snap_bytes(snap):
+        n = sum(v.nbytes for st in snap["states"] for v in st.values())
+        n += sum(v.nbytes for d in snap.get("kv", []) for v in d.values())
+        n += sum(k.nbytes + v.nbytes for k, v in snap.get("ring", []))
+        return n
+
+    HEAVY = ("states", "kv", "ring")
+
+    def _apc_put(self, snap):
+        """Automatic prefix cache: keep the snapshot (its KV segment included). Entries form a tree of prefixes (each
+        holds the KV rows past its parent). Over the RAM budget, the least recently used entries move to the SSD tier
+        (the entry object stays, so children keep their parent link); over the SSD budget, the least recently used
+        disk entries without children are dropped."""
+        snap["bytes"], snap["used"] = self._snap_bytes(snap), time.monotonic()
+        if any(e["ids"] == snap["ids"] for e in self.apc):
+            return
+        self.apc.append(snap)
+        mem = lambda: sum(e["bytes"] for e in self.apc if "states" in e)  # noqa: E731
+        while mem() > self.apc_budget:
+            cand = [e for e in self.apc if "states" in e and e is not snap and not e.get("pinned")]
+            if not cand:  # only pinned entries left in RAM: the oldest pins move to the SSD tier (still never dropped)
+                cand = [e for e in self.apc if "states" in e and e is not snap]
+                if not cand or self.apc_disk_budget <= 0:
+                    break
+            e = min(cand, key=lambda e_: e_["used"])
+            if self.apc_disk_budget > 0:
+                self._spill(e)
+            else:
+                self._drop(e)
+        while sum(e.get("disk_bytes", 0) for e in self.apc) > self.apc_disk_budget:
+            kids = {id(e["parent"]) for e in self.apc if e.get("parent") is not None}
+            cand = [e for e in self.apc if "disk" in e and id(e) not in kids and not e.get("pinned")]
+            if not cand:
+                break
+            self._drop(min(cand, key=lambda e_: e_["used"]))
+
+    def _spill(self, e):
+        import pickle
+        path = self.apc_dir / f"{uuid.uuid4().hex}.pkl"
+        with open(path, "wb") as f:
+            pickle.dump({k: e[k] for k in self.HEAVY if k in e}, f, protocol=5)
+        for k in self.HEAVY:
+            e.pop(k, None)
+        e["disk"], e["disk_bytes"] = path, path.stat().st_size
+
+    def _drop(self, e):
+        """Remove an entry; its children (they need its KV rows) go with it."""
+        doomed, changed = {id(e)}, True
+        while changed:
+            changed = False
+            for x in self.apc:
+                if id(x) not in doomed and x.get("parent") is not None and id(x["parent"]) in doomed:
+                    doomed.add(id(x))
+                    changed = True
+        for x in [x for x in self.apc if id(x) in doomed]:
+            if "disk" in x:
+                Path(x["disk"]).unlink(missing_ok=True)
+            self.apc.remove(x)
+
+    def _materialize(self, snap):
+        """The entry and its parent chain with every heavy field present: entries on the SSD tier are read back into
+        copies (the cache entries themselves stay where they are)."""
+        import pickle
+        if snap is None:
+            return None
+        out = dict(snap)
+        if "disk" in snap:
+            with open(snap["disk"], "rb") as f:
+                out.update(pickle.load(f))
+        out["parent"] = self._materialize(snap.get("parent"))
+        return out
+
