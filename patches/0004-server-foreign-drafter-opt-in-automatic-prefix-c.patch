+    def kv_rows(self, n: int, start: int = 0):
+        """Copies of KV rows [start, n) of every attention layer (the automatic prefix cache stores them with a
+        snapshot, so the prefix survives later requests that overwrite those rows; nested prefixes store only the
+        rows past their parent)."""
+        out = []
+        for d in self.kv:
+            row = {}
+            for name, (_, w) in d.items():
+                row[name] = (w[:, :, start:n] if self._kv_transposed(name) else w[:, start:n]).copy()
+            out.append(row)
+        return out
