+def truncated_call(text, finish):
+    """A note for the client when generation stopped (token limit) inside a tool call: the call is dropped (its
+    arguments are incomplete), and the note tells the model why, so it splits the work instead of resending the same
+    oversized call."""
+    if finish != "length":
+        return ""
+    tail = text.rsplit("<tool_call>", 1)
+    if len(tail) < 2 or "</tool_call>" in tail[1]:
+        return ""
+    m = re.search(r"<function=([^>\s]+)>", tail[1])
+    name = m.group(1) if m else "a tool"
+    return (f"\n\n[server: the call to `{name}` was cut off at the max_tokens limit and was not sent. Make it "
+            f"smaller: write a large file in several parts (create it, then append or edit section by section).]")
+
+
+def repeated_failed_call(messages, max_repeats):
+    """(name, count) when the last `max_repeats` assistant turns made the identical tool call and every result
+    after them failed (non-zero exit / error text): a greedy model given the same prompt repeats it forever."""
+    if max_repeats <= 0:
+        return None
+    turns, i = [], len(messages) - 1
+    while i >= 0 and len(turns) < max_repeats:
+        m = messages[i]
+        if m.get("role") == "tool":
+            j = i
+            while j >= 0 and messages[j].get("role") == "tool":
+                j -= 1
+            if j < 0 or messages[j].get("role") != "assistant" or not messages[j].get("tool_calls"):
+                return None
+            res = " ".join(str(x.get("content") or "") for x in messages[j + 1:i + 1])
+            calls = [(c.get("function", c).get("name"), json.dumps(c.get("function", c).get("arguments"),
+                                                                      sort_keys=True))
+                     for c in messages[j]["tool_calls"]]
+            turns.append((calls, res))
+            i = j - 1
+        elif m.get("role") in ("user", "system"):
+            i -= 1
