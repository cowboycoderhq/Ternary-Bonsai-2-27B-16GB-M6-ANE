+    def _pin_record(self, ids):
+        """Most recent first, distinct, at most --pin-max; written atomically."""
+        if self.a.pin_max <= 0 or len(ids) < 256:
+            return
+        ids = list(ids)
+        # a prefix of a recorded pin, or a pin that is a prefix of this one, is the same client: keep the longer one
+        self.pins = ([ids] + [p for p in self.pins if p != ids and p[:len(ids)] != ids and ids[:len(p)] != p]
